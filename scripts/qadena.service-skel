[Unit]
Description=Qadena Run Script
After=network.target

[Service]
Type=simple
User=<username>
ExecStart=nohup bash -c "/home/<username>/qadena/scripts/run.sh 2>&1 | rotatelogs -l -D -L /home/<username>/qadena/logs/qadena.log /home/<username>/qadena/logs/qadena-%Y-%m-%d.log 86400"
WorkingDirectory=/home/<username>/qadena
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target